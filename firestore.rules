rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function activeAccount() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !('deletionRequestedAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'deletionRequestedAt'])
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('email', request.auth.token.email) == request.auth.token.email;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'deletionRequestedAt'])
        && (!('deletionRequestedAt' in resource.data) || 'deletionRequestedAt' in request.resource.data);
      allow delete: if owner(uid);
    }
    match /products/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /{collection}/{id} {
      function orderCollection() { return collection in ['maintenance_orders', 'scrap_orders', 'pipe_installation_orders']; }
      allow read: if orderCollection() && (admin() || owner(resource.data.userId));
      allow create: if orderCollection() && activeAccount()
        && owner(request.resource.data.userId)
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.status == 'جديد'
        && request.resource.data.createdAt == request.time
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.clientName.size() <= 200
        && request.resource.data.clientPhone is string
        && request.resource.data.clientPhone.size() >= 8
        && request.resource.data.clientPhone.size() <= 30
        && request.resource.data.keys().hasOnly(['clientName', 'clientPhone', 'userId', 'userEmail', 'status', 'createdAt', 'imageBase64', 'locationUrl', 'serviceType', 'description', 'scrapType', 'estimatedWeight', 'address', 'unitCount'])
        && (collection != 'pipe_installation_orders' || (
          request.resource.data.serviceType == 'تأسيس مواسير التكييفات'
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.unitCount is int
          && request.resource.data.unitCount >= 1
          && request.resource.data.unitCount <= 100
        ));
      allow update: if orderCollection() && admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['جديد', 'قيد المعاينة', 'تم التنفيذ', 'ملغي'];
      allow delete: if orderCollection() && (admin() || owner(resource.data.userId));
    }
  }
}
